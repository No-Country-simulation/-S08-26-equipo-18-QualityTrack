# QualityTrack - Frontend: Variables de entorno
# -------------------------------------------------------------
# Este archivo es una plantilla de configuracion.
# Copiar como .env antes de iniciar la aplicacion: cp .env.example .env

# -----------------------------------

# Este archivo es una plantilla.
# Copiar como .env antes de iniciar la aplicación.

# URL base de la API del Backend (NestJS)
# - En desarrollo local (Docker o local): http://localhost:3000
# - En producción: URL de la API desplegada (ej. Render)
# - En produccion: URL de la API desplegada (ej. https://api.qualitytrack.com)
VITE_API_URL=http://localhost:3000

# Tiempo maximo de espera para peticiones HTTP en milisegundos (por defecto: 15000 = 15s)
VITE_API_TIMEOUT_MS=15000

# Entorno de ejecucion opcional (development | staging | production)
VITE_APP_ENV=development