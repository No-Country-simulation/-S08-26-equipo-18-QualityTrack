# QualityTrack - Variables de entorno

# -----------------------------------

# Este archivo es una plantilla.

# Copiar como .env antes de ejecutar Docker Compose.

POSTGRES_DB=qualitytrack
POSTGRES_USER=qualitytrack
POSTGRES_PASSWORD=qualitytrack_dev

# Conexión a la base de datos (Supabase en la nube en producción)
DB_HOST=localhost
DB_PORT=5432
# En Supabase debe ser "true"; en local con Docker Compose "false"
DB_SSL=false