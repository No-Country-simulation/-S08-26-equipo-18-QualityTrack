# Desarrollo local: copiar como .env. Los valores reales no se versionan.
POSTGRES_DB=qualitytrack
POSTGRES_USER=qualitytrack
# Obligatoria: elegir una contraseña local.
POSTGRES_PASSWORD=

# Docker Compose usa postgres:5432 y DB_SSL=false dentro del backend.
# Para ejecutar el backend fuera de Docker, copiar este .env a backend/.env.
DB_HOST=localhost
DB_PORT=5432
DB_SSL=false
# Para BD remota: DB_SSL=true. Opcional: certificado CA PEM del proveedor.
# Admite saltos de línea reales o escapados como \n. Nunca usar una clave privada.
DB_SSL_CA=

# Solo backend: generar un valor aleatorio; mínimo 32 caracteres.
# node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
# No reutilizar en producción ni colocar en una variable VITE_*.
JWT_ACCESS_SECRET=
CORS_ORIGINS=http://localhost:5173

# Credenciales del administrador inicial; se usan al ejecutar el seed manual.
ADMIN_EMAIL=admin@qualitytrack.local
ADMIN_PASSWORD=
ADMIN_FIRST_NAME=Administrador
ADMIN_LAST_NAME=QualityTrack
# Obligatorio al crear el administrador inicial. Completar con su DNI real; no se genera.
ADMIN_DNI=

# Documentos: buffer acotado por archivo (10 MiB por defecto; máximo 100 MiB).
# Fuera de Compose, elegir una carpeta persistente con permisos del backend.
DOCUMENT_STORAGE_DIR=./uploads/documents
DOCUMENT_MAX_FILE_BYTES=10485760
DOCUMENT_ALLOWED_EXTENSIONS=pdf,png,jpg,jpeg,txt,csv
