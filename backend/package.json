{
    "name": "backend",
    "version": "0.0.1",
    "description": "",
    "author": "",
    "private": true,
    "license": "MIT",
    "scripts": {
        "build": "nest build",
        "start": "node dist/src/main.jst",
        "start:dev": "nest start --watch",
        "start:debug": "nest start --debug --watch",
        "format": "prettier --write \"src/**/*.ts\"",
        "test": "jest",
        "test:cov": "jest --coverage",
        "test:e2e": "jest --config ./test/jest-e2e.json",
        "migration:create": "mikro-orm migration:create --config ./mikro-orm.config.ts",
        "migration:up": "mikro-orm migration:up --config ./mikro-orm.config.ts",
        "migration:down": "mikro-orm migration:down --config ./mikro-orm.config.ts"
    },
    "mikro-orm": {
        "configPaths": [
            "./dist/mikro-orm.config.js",
            "./mikro-orm.config.ts"
        ]
    },
    "dependencies": {
        "@mikro-orm/cli": "^7.1.15",
        "@mikro-orm/core": "^7.1.15",
        "@mikro-orm/decorators": "^7.1.15",
        "@mikro-orm/migrations": "^7.1.15",
        "@mikro-orm/nestjs": "^7.1.0",
        "@mikro-orm/postgresql": "^7.1.15",
        "@nestjs/common": "^12.0.1",
        "@nestjs/config": "^12.0.0",
        "@nestjs/core": "^12.0.1",
        "@nestjs/platform-express": "^12.0.1",
        "@swc-node/register": "^1.12.1",
        "reflect-metadata": "^0.2.0",
        "rxjs": "^7.2.0"
    },
    "devDependencies": {
        "@nestjs/cli": "^12.0.0",
        "@nestjs/testing": "^12.0.1",
        "@swc/cli": "^0.8.1",
        "@swc/core": "^1.16.2",
        "@types/node": "^26.4.1",
        "jest": "30.4.2",
        "prettier": "3.9.6",
        "supertest": "7.2.2",
        "typescript": "^6.0.3"
    }
}
